# Copy this file to .env for local development.
# PostgreSQL is the supported shared/deployment database.
DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense
SECRET_KEY=replace-this-with-a-random-secret

# SMTP is required for email-based password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=StockSense <no-reply@example.com>
SMTP_USE_TLS=true
